@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="min-h-screen bg-zinc-950 text-zinc-100 flex flex-col font-sans selection:bg-emerald-500/20 selection:text-emerald-400">
    <!-- 56px Editorial Header -->
    <header class="sticky top-0 z-40 h-14 bg-zinc-950/90 backdrop-blur-md border-b border-white/10 px-4 sm:px-8 flex items-center justify-between">
        <div class="flex items-center gap-8">
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500/20 group-hover:border-emerald-500/30 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                    </svg>
                </div>
                <span class="font-bold text-base tracking-tight text-white">TuneTrack</span>
            </a>

            <nav class="flex items-center gap-1 sm:gap-2">
                <a href="/" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors @(IsActive("/") ? "text-white bg-white/[0.08]" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.03]")">
                    Analyzer
                </a>
                <a href="/history" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors @(IsActive("/history") ? "text-white bg-white/[0.08]" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.03]")">
                    History
                </a>
                <a href="/saved" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors @(IsActive("/saved") ? "text-white bg-white/[0.08]" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.03]")">
                    Saved
                </a>
            </nav>
        </div>

        <div class="flex items-center gap-3">
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs text-zinc-400 font-mono">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Active</span>
            </span>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 pb-16">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-4 right-4 max-w-md bg-zinc-900 border border-red-500/30 text-zinc-200 px-4 py-3 rounded-lg shadow-2xl z-50 flex items-center justify-between text-sm hidden">
    <span>An error occurred in the interactive session.</span>
    <a href="." class="reload ml-4 px-2 py-1 bg-white/10 hover:bg-white/20 rounded text-xs font-semibold text-white">Reload</a>
    <span class="dismiss cursor-pointer ml-2 text-zinc-400 hover:text-white">✕</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (_, __) => StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path == "/" || path == "")
        {
            return string.IsNullOrEmpty(relative);
        }
        return relative.StartsWith(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }
}
