@inherits LayoutComponentBase

<div class="min-h-screen bg-zinc-950 text-zinc-100 flex flex-col">
    <main class="flex-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 right-0 hidden bg-amber-500 text-black px-4 py-2 z-50">
    An unhandled error has occurred.
    <a href="." class="reload underline font-semibold ml-2">Reload</a>
    <span class="dismiss cursor-pointer ml-4">🗙</span>
</div>
