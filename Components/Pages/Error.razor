@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Error — TuneTrack</PageTitle>

<div class="max-w-md mx-auto px-4 py-24 text-center space-y-4">
    <div class="w-12 h-12 rounded-full bg-red-950/40 border border-red-500/20 flex items-center justify-center mx-auto text-red-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    </div>
    <h1 class="text-xl font-bold tracking-tight text-white">Something Went Wrong</h1>
    <p class="text-xs text-zinc-400 leading-relaxed">
        An unhandled exception occurred while processing your request.
    </p>
    @if (ShowRequestId)
    {
        <p class="text-[11px] font-mono text-zinc-500 bg-zinc-900/60 p-2 rounded border border-white/5 inline-block">
            Request ID: @RequestId
        </p>
    }
    <div class="pt-2">
        <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-xs transition-colors">
            Return to Safety
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
