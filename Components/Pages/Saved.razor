@page "/saved"
@rendermode InteractiveServer
@inject IPlaylistService PlaylistService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Saved Recommendations — TuneTrack</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/10">
        <div>
            <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white">Saved Recommendations</h1>
            <p class="text-xs sm:text-sm text-zinc-400 mt-1">Suggested tracks bookmarked during your playlist analyses.</p>
        </div>
        <a href="/" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs font-semibold text-zinc-200 hover:text-white transition-colors self-start sm:self-auto">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Explore More Music</span>
        </a>
    </div>

    <!-- Saved List State -->
    @if (isLoading)
    {
        <div class="divide-y divide-white/5 border-b border-white/10 animate-pulse">
            @for (int i = 0; i < 4; i++)
            {
                <div class="py-4 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-zinc-900 flex-shrink-0"></div>
                    <div class="space-y-2 flex-1">
                        <div class="h-4 w-48 bg-zinc-900 rounded"></div>
                        <div class="h-3 w-32 bg-zinc-900 rounded"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (savedItems.Count == 0)
    {
        <!-- Empty State -->
        <div class="py-16 text-center space-y-4 max-w-sm mx-auto">
            <div class="w-12 h-12 rounded-full bg-zinc-900 border border-white/10 flex items-center justify-center mx-auto text-zinc-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
            </div>
            <h2 class="font-display text-base font-semibold text-white">No saved recommendations yet</h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
                When analyzing a playlist, click the bookmark icon on any suggested track to save it here for later listening.
            </p>
            <div class="pt-2">
                <a href="/" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-xs transition-colors">
                    Find Recommendations
                </a>
            </div>
        </div>
    }
    else
    {
        <span class="sr-only" aria-live="polite">@(copiedItemTitle != null ? $"Copied {copiedItemTitle} to clipboard" : "")</span>
        <div class="divide-y divide-white/5 border-b border-white/10">
            @foreach (var item in savedItems)
            {
                <div class="py-3.5 hover:bg-white/[0.03] -mx-2 px-2 rounded-lg transition-colors flex items-center justify-between gap-4 group">
                    <div class="flex items-center gap-3.5 min-w-0 flex-1">
                        <!-- Artwork Thumbnail -->
                        <div class="w-12 h-12 rounded-lg bg-zinc-900 overflow-hidden flex-shrink-0">
                            @if (!string.IsNullOrEmpty(item.ArtworkUrl))
                            {
                                <img src="@item.ArtworkUrl" alt="@item.Title" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-zinc-500">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                                    </svg>
                                </div>
                            }
                        </div>

                        <!-- Track Info -->
                        <div class="min-w-0 flex-1 space-y-0.5">
                            <h2 class="font-sans text-sm sm:text-base font-semibold text-white truncate">
                                @item.Title
                            </h2>
                            <p class="text-xs text-zinc-400 truncate">
                                @item.Artist
                            </p>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 pt-0.5">
                                @if (!string.IsNullOrEmpty(item.Genre))
                                {
                                    <span class="text-xs text-zinc-400 font-mono">
                                        @item.Genre
                                    </span>
                                }
                                @if (item.SourcePlaylistId.HasValue)
                                {
                                    <a href="/?id=@item.SourcePlaylistId" class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                        View source report
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Actions: Copy & Remove -->
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <button @onclick="() => CopyTrack(item)"
                                title="Copy Title — Artist"
                                aria-label="Copy track info"
                                class="p-2 rounded-lg hover:bg-white/10 text-zinc-400 hover:text-white transition-colors">
                            @if (copiedItemTitle == item.Title)
                            {
                                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                            }
                        </button>

                        <button @onclick="() => RemoveSaved(item.Id)"
                                title="Remove from saved"
                                aria-label="Remove recommendation"
                                class="p-2 rounded-lg hover:bg-red-500/10 text-zinc-400 hover:text-red-400 transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string clientId = "";
    private string? copiedItemTitle;
    private List<SavedRecommendation> savedItems = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                clientId = await JS.InvokeAsync<string>("tuneTrack.getClientId");
                await LoadSaved();
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadSaved()
    {
        if (string.IsNullOrWhiteSpace(clientId)) return;
        savedItems = await PlaylistService.GetSavedRecommendationsAsync(clientId);
    }

    private async Task CopyTrack(SavedRecommendation item)
    {
        string text = $"{item.Title} — {item.Artist}";
        bool success = await JS.InvokeAsync<bool>("tuneTrack.copyToClipboard", text);
        if (success)
        {
            copiedItemTitle = item.Title;
            StateHasChanged();
            await Task.Delay(1500);
            if (copiedItemTitle == item.Title)
            {
                copiedItemTitle = null;
                StateHasChanged();
            }
        }
    }

    private async Task RemoveSaved(int id)
    {
        if (string.IsNullOrWhiteSpace(clientId)) return;
        bool removed = await PlaylistService.RemoveSavedRecommendationAsync(id, clientId);
        if (removed)
        {
            savedItems.RemoveAll(s => s.Id == id);
            StateHasChanged();
        }
    }
}
