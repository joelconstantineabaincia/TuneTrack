@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@inject IPlaylistService PlaylistService
@inject ISamplePlaylistService SampleService
@inject IDiversityScorer DiversityScorer
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Playlist Analyzer — TuneTrack</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
    <!-- Top Search & Input Strip -->
    <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1 min-w-0">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text"
                       @bind="inputUrl"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       aria-label="Playlist URL"
                       placeholder="Paste Spotify, Apple Music, or YouTube link..."
                       class="w-full pl-10 @(string.IsNullOrWhiteSpace(inputUrl) ? "pr-4" : string.IsNullOrWhiteSpace(DetectedPlatform) ? "pr-10" : "pr-36") py-2.5 bg-zinc-900 border border-white/10 rounded-lg text-sm text-zinc-100 placeholder-zinc-400 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 outline-none transition-all" />

                <!-- Auto-detected platform badge & clear control inside input -->
                @if (!string.IsNullOrWhiteSpace(inputUrl))
                {
                    <div class="absolute inset-y-0 right-2 flex items-center gap-1.5">
                        @if (!string.IsNullOrWhiteSpace(DetectedPlatform))
                        {
                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium @GetPlatformBadgeClass(DetectedPlatform)">
                                @DetectedPlatform
                            </span>
                        }
                        <button type="button"
                                @onclick="() => inputUrl = string.Empty"
                                class="text-zinc-400 hover:text-zinc-200 p-1 rounded"
                                aria-label="Clear input">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

            <button @onclick="AnalyzeEnteredUrl"
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(inputUrl))"
                    class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed text-zinc-950 font-semibold text-sm rounded-lg flex items-center justify-center gap-2 transition-all focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 outline-none">
                @if (isLoading)
                {
                    <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Analyzing...</span>
                }
                else
                {
                    <span>Analyze</span>
                }
            </button>
        </div>

        <!-- Sample Playlists Strip (single-line mobile scroll, active highlight) -->
        @if (dashboard != null || isLoading)
        {
            <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:flex-wrap text-xs max-w-full">
                <span class="text-zinc-400 font-medium whitespace-nowrap flex-shrink-0">Try offline sample:</span>
                @foreach (var sample in SampleService.GetSamplePlaylists())
                {
                    bool isCurrentSample = dashboard?.Playlist.Title == sample.Title;
                    <button @onclick="() => LoadSample(sample.Id)"
                            disabled="@isLoading"
                            class="px-2.5 py-1 rounded bg-zinc-900 hover:bg-zinc-800 border transition-colors flex items-center gap-1.5 whitespace-nowrap flex-shrink-0 focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none @(isCurrentSample ? "border-emerald-500/40 bg-white/[0.08] text-white" : "border-white/5 text-zinc-300 hover:text-white")">
                        <span>@sample.Title.Split(':')[0]</span>
                        <span class="text-[11px] px-1.5 py-0.5 rounded @(sample.DiversityBadge == "High Diversity" ? "bg-emerald-500/10 text-emerald-400" : sample.DiversityBadge == "Low Diversity" ? "bg-rose-500/10 text-rose-400" : "bg-cyan-500/10 text-cyan-400")">
                            @sample.DiversityBadge
                        </span>
                    </button>
                }
            </div>
        }
    </div>

    <!-- Error State -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-4 rounded-lg bg-red-950/40 border border-red-500/20 text-red-200 text-sm flex items-start justify-between gap-4">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>@errorMessage</span>
            </div>
            <button @onclick="() => errorMessage = null" class="text-red-400 hover:text-red-200 text-xs">Dismiss</button>
        </div>
    }

    <!-- Loading Skeleton State -->
    @if (isLoading)
    {
        <div class="space-y-8">
            @if (showMatchingProgress && matchingTotal > 0)
            {
                <div role="status" aria-live="polite" class="flex items-center justify-between gap-4 py-2.5 border-b border-white/10 text-xs sm:text-sm text-zinc-300">
                    <span class="inline-flex items-center gap-2 font-medium">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
                        <span>Matching tracks… <span class="font-mono tabular-nums text-white">@matchingCompleted/@matchingTotal</span></span>
                    </span>
                    <div class="w-32 sm:w-48 h-1.5 bg-zinc-800 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-400 rounded-full transition-all duration-300"
                             style="width: @((int)Math.Round((double)matchingCompleted / matchingTotal * 100))%"></div>
                    </div>
                </div>
            }

            <div class="space-y-8 animate-pulse">
            <!-- Header skeleton -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 pt-1 pb-8 border-b border-white/10">
                <div class="w-36 h-36 sm:w-40 sm:h-40 bg-zinc-900 rounded-lg flex-shrink-0"></div>
                <div class="space-y-3 flex-1 w-full">
                    <div class="h-4 w-24 bg-zinc-900 rounded"></div>
                    <div class="h-8 w-3/4 bg-zinc-900 rounded"></div>
                    <div class="h-4 w-1/2 bg-zinc-900 rounded"></div>
                </div>
            </div>

            <!-- Grid skeleton -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <div class="lg:col-span-8 space-y-4">
                    <div class="h-9 bg-zinc-900 rounded-md"></div>
                    <div class="divide-y divide-white/5">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="h-14 bg-zinc-950"></div>
                        }
                    </div>
                </div>
                <div class="lg:col-span-4 space-y-7">
                    <div class="h-44 border-b border-white/10"></div>
                    <div class="h-56 border-b border-white/10"></div>
                </div>
            </div>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        bool isPartialView = dashboard.IsPartialResult || showPasteFallback || dashboard.Playlist.Tracks.Count == 0;

        <!-- Borderless Editorial Playlist Header -->
        <section aria-label="Playlist overview" class="pt-1 pb-8 border-b border-white/10">
            <div class="flex flex-row items-start gap-4 sm:gap-8 text-left">
                <!-- Cover Art -->
                <div class="w-20 h-20 sm:w-40 sm:h-40 rounded-lg overflow-hidden bg-zinc-900 flex-shrink-0">
                    @if (!string.IsNullOrEmpty(dashboard.Playlist.CoverUrl))
                    {
                        <img src="@dashboard.Playlist.CoverUrl" alt="@dashboard.Playlist.Title cover" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center text-zinc-500">
                            <svg class="w-8 h-8 sm:w-12 sm:h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                            </svg>
                        </div>
                    }
                </div>

                <!-- Playlist Metadata & Stats -->
                <div class="flex-1 min-w-0 space-y-2.5">
                    <h1 class="font-display text-xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white break-words leading-tight">
                        @dashboard.Playlist.Title
                    </h1>

                    @if (!isPartialView)
                    {
                        <!-- Inline Stat Strip (no orphaned middots when wrapping) -->
                        int genreCount = GetDistinctGenreCount();
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-zinc-300 font-mono tabular-nums">
                            <span class="inline-flex items-center gap-1.5 font-bold whitespace-nowrap @GetScoreColor(dashboard.Diversity.TotalScore)">
                                <span class="w-2 h-2 rounded-full bg-current" aria-hidden="true"></span>
                                <span>@FormatWholeScore(dashboard.Diversity.TotalScore) Diversity</span>
                            </span>
                            <span class="whitespace-nowrap">@Pluralize(dashboard.Playlist.TrackCount, "Track", "Tracks")</span>
                            <span class="whitespace-nowrap">@dashboard.Playlist.TotalDuration</span>
                            <span class="whitespace-nowrap">@Pluralize(genreCount, "Genre", "Genres")</span>
                        </div>
                    }

                    <div class="flex flex-wrap items-center gap-2.5 pt-0.5">
                        <span class="px-2 py-0.5 rounded text-xs font-medium whitespace-nowrap @GetPlatformBadgeClass(dashboard.Playlist.Platform)">
                            @dashboard.Playlist.Platform
                        </span>
                        @if (!isPartialView)
                        {
                            <span class="text-xs text-zinc-400 font-mono">Analyzed @FormatDisplayDate(dashboard.Playlist.AnalyzedAt)</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        @if (isPartialView)
        {
            string fallbackCopy = !string.IsNullOrWhiteSpace(dashboard.WarningMessage) && !dashboard.WarningMessage.Contains('!')
                ? dashboard.WarningMessage
                : $"{dashboard.Playlist.Platform} doesn't share track lists publicly. Paste your tracks, one 'Artist - Title' per line, and we'll analyze them.";

            <!-- Partial Result Paste Fallback -->
            <section aria-label="Paste tracklist" class="p-5 rounded-xl bg-zinc-900/70 border border-amber-500/25 space-y-3 max-w-3xl">
                <div class="flex items-center gap-2 font-medium text-sm text-amber-300">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Paste your tracklist</span>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed">
                    @fallbackCopy
                </p>
                <div class="space-y-3">
                    <label for="pasted-tracklist" class="sr-only">Tracklist, one Artist - Title per line</label>
                    <textarea id="pasted-tracklist"
                              @bind="pastedTrackList"
                              rows="5"
                              placeholder="@PastedTrackListPlaceholder"
                              class="w-full p-3 bg-zinc-950 border border-white/15 rounded-lg text-xs font-mono text-zinc-100 placeholder-zinc-400 focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none"></textarea>
                    <button type="button"
                            @onclick="AnalyzePastedList"
                            disabled="@(string.IsNullOrWhiteSpace(pastedTrackList) || isLoading)"
                            class="px-4 py-2 bg-amber-400 hover:bg-amber-300 disabled:opacity-50 disabled:cursor-not-allowed text-zinc-950 font-semibold text-xs rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none">
                        Analyze Pasted Tracks
                    </button>
                </div>
            </section>
        }
        else
        {
            <!-- 2-Column Asymmetric Workspace -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left 8 Columns: Searchable Tracklist Table -->
            <div class="lg:col-span-8 min-w-0 space-y-4">
                <!-- Search & All-Genres Scrollable Filter Bar -->
                <div class="space-y-2.5 min-w-0">
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <input type="text"
                               @bind="trackSearchQuery"
                               @bind:event="oninput"
                               aria-label="Filter tracks by title, artist, or album"
                               placeholder="Filter tracks by title, artist, or album..."
                               class="w-full pl-9 pr-3 py-1.5 bg-zinc-900 border border-white/10 rounded-md text-xs text-zinc-100 placeholder-zinc-400 focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none" />
                    </div>

                    @{
                        var allGenres = GetAllGenres();
                    }
                    @if (allGenres.Count > 0)
                    {
                        <div class="flex items-center gap-1.5 overflow-x-auto max-w-full pb-1" role="region" aria-label="Filter tracks by genre">
                            <button type="button"
                                    @onclick="() => selectedGenreFilter = null"
                                    class="px-2.5 py-1 text-xs rounded whitespace-nowrap flex-shrink-0 transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none @(selectedGenreFilter == null ? "bg-white/15 text-white font-medium" : "text-zinc-400 hover:text-white bg-zinc-900")">
                                All (@dashboard.Playlist.Tracks.Count)
                            </button>
                            @foreach (var g in allGenres)
                            {
                                <button type="button"
                                        @onclick="() => selectedGenreFilter = g"
                                        class="px-2.5 py-1 text-xs rounded whitespace-nowrap flex-shrink-0 transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none @(selectedGenreFilter == g ? "bg-emerald-500/20 text-emerald-300 font-medium border border-emerald-500/30" : "text-zinc-400 hover:text-white bg-zinc-900")">
                                    @g
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Borderless Tracklist Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="border-b border-white/10 text-zinc-400 uppercase tracking-wider text-[11px] font-semibold">
                            <tr>
                                <th scope="col" class="py-3 pr-2 w-8 text-center">#</th>
                                <th scope="col" class="py-3 px-2 sm:px-3">Title &amp; Artist</th>
                                <th scope="col" class="py-3 px-3 hidden md:table-cell">Album</th>
                                <th scope="col" class="py-3 px-3 hidden sm:table-cell">Genre</th>
                                <th scope="col" class="py-3 px-3 text-center hidden sm:table-cell">Year</th>
                                <th scope="col" class="py-3 pl-2 text-right">Time</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 font-sans">
                            @{
                                var filteredTracks = GetFilteredTracks();
                            }
                            @if (filteredTracks.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-zinc-400 space-y-2">
                                        <p>No tracks match the filter.</p>
                                        @if (!string.IsNullOrWhiteSpace(trackSearchQuery) || !string.IsNullOrWhiteSpace(selectedGenreFilter))
                                        {
                                            <button type="button"
                                                    @onclick="() => { trackSearchQuery = string.Empty; selectedGenreFilter = null; }"
                                                    class="px-3 py-1 rounded bg-white/[0.08] hover:bg-white/[0.14] text-xs font-medium text-white transition-colors">
                                                Reset filters
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @for (int i = 0; i < filteredTracks.Count; i++)
                            {
                                var track = filteredTracks[i];
                                <tr class="group hover:bg-white/[0.04] transition-colors">
                                    <td class="py-3 pr-2 text-center text-zinc-400 font-mono text-[11px] tabular-nums">
                                        @(i + 1)
                                    </td>
                                    <td class="py-3 px-2 sm:px-3 min-w-0">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="w-9 h-9 rounded bg-zinc-800 flex-shrink-0 overflow-hidden">
                                                @{
                                                    bool showTrackArtwork = !string.IsNullOrEmpty(track.ArtworkUrl) &&
                                                        (string.Equals(dashboard.Playlist.Platform, "Sample", StringComparison.OrdinalIgnoreCase) ||
                                                         !string.Equals(track.ArtworkUrl, dashboard.Playlist.CoverUrl, StringComparison.OrdinalIgnoreCase));
                                                }
                                                @if (showTrackArtwork)
                                                {
                                                    <img src="@track.ArtworkUrl" alt="@track.Title cover" loading="lazy" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center text-zinc-400">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13" />
                                                        </svg>
                                                    </div>
                                                }
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="font-medium text-white truncate">@track.Title</p>
                                                <p class="text-zinc-400 text-xs truncate">
                                                    @track.Artist<span class="sm:hidden font-mono">@(track.ReleaseYear.HasValue ? $" · {track.ReleaseYear}" : "")</span>
                                                </p>
                                                @if (!string.IsNullOrEmpty(track.Genre))
                                                {
                                                    <span class="sm:hidden inline-block mt-1 px-2 py-0.5 rounded-full bg-white/[0.06] text-zinc-300 text-[11px] whitespace-nowrap max-w-full truncate">
                                                        @track.Genre
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3 text-zinc-400 hidden md:table-cell truncate max-w-[150px]">
                                        @(track.Album ?? "—")
                                    </td>
                                    <td class="py-3 px-3 hidden sm:table-cell">
                                        @if (!string.IsNullOrEmpty(track.Genre))
                                        {
                                            <span class="inline-block px-2 py-0.5 rounded-full bg-white/[0.06] text-zinc-300 text-[11px] whitespace-nowrap">
                                                @track.Genre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-zinc-400">—</span>
                                        }
                                    </td>
                                    <td class="py-3 px-3 text-center text-zinc-400 font-mono text-[11px] tabular-nums hidden sm:table-cell">
                                        @(track.ReleaseYear?.ToString() ?? "—")
                                    </td>
                                    <td class="py-3 pl-2 text-right text-zinc-400 font-mono text-[11px] tabular-nums whitespace-nowrap">
                                        @FormatTrackDuration(track.DurationMs)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right 4 Columns: Borderless Sticky Sidebar with Metrics & Suggested Tracks -->
            <aside aria-label="Diversity metrics and recommendations" class="lg:col-span-4 min-w-0 space-y-7 lg:sticky lg:top-20">
                <!-- Diversity Scorecard -->
                <section class="pb-7 border-b border-white/10 space-y-4">
                    @{
                        int totalTrackCount = dashboard.Playlist.Tracks.Count;
                        int matchedTrackCount = dashboard.Playlist.Tracks.Count(t =>
                            !string.IsNullOrWhiteSpace(t.Genre) ||
                            t.ReleaseYear.HasValue ||
                            !string.IsNullOrWhiteSpace(t.Album));
                    }
                    <div class="flex items-baseline justify-between gap-2">
                        <h2 class="font-display text-sm font-semibold text-zinc-100">Diversity Score</h2>
                        <span class="text-xs text-zinc-400 font-mono tabular-nums">
                            Matched @matchedTrackCount of @totalTrackCount tracks
                        </span>
                    </div>

                    <div class="flex items-baseline gap-3.5">
                        <div class="flex items-baseline gap-1 font-mono tabular-nums flex-shrink-0">
                            <span class="text-4xl font-bold tracking-tight text-white">
                                @FormatWholeScore(dashboard.Diversity.TotalScore)
                            </span>
                            <span class="text-sm text-zinc-400">/ 100</span>
                        </div>
                        <span class="text-xs text-zinc-400 leading-relaxed">
                            @dashboard.Diversity.Summary
                        </span>
                    </div>

                    <!-- 3 Metric Bars -->
                    <div class="space-y-3 pt-3 border-t border-white/5 text-xs">
                        <!-- Genre Variety (40%) -->
                        <div class="space-y-1">
                            <div class="flex justify-between text-zinc-400">
                                <span>Genre Variety <span class="font-mono text-[11px]">(40% weight)</span></span>
                                <span class="font-mono tabular-nums text-zinc-200">@FormatWholeScore(dashboard.Diversity.GenreVariety)%</span>
                            </div>
                            <div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden">
                                <div class="h-full bg-cyan-400 rounded-full transition-all duration-500" style="width: @(dashboard.Diversity.GenreVariety.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>

                        <!-- Artist Uniqueness (35%) -->
                        <div class="space-y-1">
                            <div class="flex justify-between text-zinc-400">
                                <span>Artist Uniqueness <span class="font-mono text-[11px]">(35% weight)</span></span>
                                <span class="font-mono tabular-nums text-zinc-200">@FormatWholeScore(dashboard.Diversity.ArtistUniqueness)%</span>
                            </div>
                            <div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-500" style="width: @(dashboard.Diversity.ArtistUniqueness.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>

                        <!-- Era Spread (25%) -->
                        <div class="space-y-1">
                            <div class="flex justify-between text-zinc-400">
                                <span>Era Spread <span class="font-mono text-[11px]">(25% weight)</span></span>
                                <span class="font-mono tabular-nums text-zinc-200">@FormatWholeScore(dashboard.Diversity.EraSpread)%</span>
                            </div>
                            <div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden">
                                <div class="h-full bg-purple-400 rounded-full transition-all duration-500" style="width: @(dashboard.Diversity.EraSpread.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Genre Distribution Breakdown -->
                <section class="pb-7 border-b border-white/10 space-y-3">
                    <h2 class="font-display text-sm font-semibold text-zinc-100">Genre Distribution</h2>
                    @{
                        var genreDistribution = GetGenreDistribution(5);
                    }
                    @if (genreDistribution.Count == 0)
                    {
                        <p class="text-xs text-zinc-400">No matched genre data yet.</p>
                    }
                    else
                    {
                        <div class="space-y-2.5 text-xs">
                            @foreach (var genreStat in genreDistribution)
                            {
                                <div class="space-y-1">
                                    <div class="flex justify-between text-zinc-300">
                                        <span class="truncate pr-2">@genreStat.Genre</span>
                                        <span class="font-mono tabular-nums text-zinc-400">@genreStat.Percentage%</span>
                                    </div>
                                    <div class="h-1 w-full bg-zinc-800 rounded-full overflow-hidden">
                                        <div class="h-full bg-white/40 rounded-full" style="width: @(genreStat.Percentage)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <!-- Suggested Music to Add -->
                <section class="space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="font-display text-sm font-semibold text-zinc-100">Suggested to Expand</h2>
                        <span class="text-xs text-zinc-400 font-mono">Audio previews</span>
                    </div>
                    <span class="sr-only" aria-live="polite">@(copiedTrackTitle != null ? $"Copied {copiedTrackTitle} to clipboard" : "")</span>

                    @if (dashboard.Recommendations.Count == 0)
                    {
                        <p class="text-xs text-zinc-400 py-4 text-center">No additional suggestions available for this set.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-white/5">
                            @foreach (var rec in dashboard.Recommendations)
                            {
                                bool isSaved = savedTrackTitles.Contains(rec.Title);
                                bool isPlaying = currentPlayingPreview == rec.PreviewUrl && !string.IsNullOrEmpty(rec.PreviewUrl);

                                <div class="py-3 first:pt-1 last:pb-1 hover:bg-white/[0.04] transition-colors flex items-center justify-between gap-3 group">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <!-- Artwork with Visible Preview Play Button -->
                                        <div class="relative w-11 h-11 rounded overflow-hidden bg-zinc-800 flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(rec.ArtworkUrl))
                                            {
                                                <img src="@rec.ArtworkUrl" alt="@rec.Title cover" loading="lazy" class="w-full h-full object-cover" />
                                            }
                                            @if (!string.IsNullOrEmpty(rec.PreviewUrl))
                                            {
                                                <button type="button"
                                                        @onclick="() => TogglePreview(rec.PreviewUrl)"
                                                        aria-label="@(isPlaying ? $"Pause preview for {rec.Title}" : $"Play 30-second preview for {rec.Title}")"
                                                        class="absolute inset-0 flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none @(isPlaying ? "bg-emerald-950/80" : "bg-black/30 group-hover:bg-black/55")">
                                                    @if (isPlaying)
                                                    {
                                                        <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center">
                                                            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                <rect x="6" y="4" width="4" height="16" rx="1" />
                                                                <rect x="14" y="4" width="4" height="16" rx="1" />
                                                            </svg>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="w-6 h-6 rounded-full bg-zinc-950/75 group-hover:bg-zinc-950/90 flex items-center justify-center transition-colors">
                                                            <svg class="w-3 h-3 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                <polygon points="5 3 19 12 5 21 5 3" />
                                                            </svg>
                                                        </span>
                                                    }
                                                </button>
                                            }
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-medium text-white truncate">@rec.Title</p>
                                            <p class="text-xs text-zinc-400 truncate">@rec.Artist</p>
                                            <span class="inline-block text-xs text-zinc-400 font-mono mt-0.5">@rec.Genre</span>
                                        </div>
                                    </div>

                                    <!-- Action Buttons: Copy & Bookmark -->
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        <!-- Copy button -->
                                        <button type="button"
                                                @onclick="() => CopyTrack(rec)"
                                                title="Copy Title — Artist"
                                                aria-label="Copy @rec.Title by @rec.Artist"
                                                class="p-2 rounded hover:bg-white/10 text-zinc-400 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none">
                                            @if (copiedTrackTitle == rec.Title)
                                            {
                                                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                </svg>
                                            }
                                        </button>

                                        <!-- Bookmark button -->
                                        <button type="button"
                                                @onclick="() => ToggleBookmark(rec)"
                                                title="@(isSaved ? "Saved in Bookmarks" : "Bookmark this suggestion")"
                                                aria-label="@(isSaved ? $"Remove bookmark for {rec.Title}" : $"Bookmark {rec.Title}")"
                                                class="p-2 rounded hover:bg-white/10 transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 outline-none @(isSaved ? "text-emerald-400" : "text-zinc-400 hover:text-white")">
                                            <svg class="w-3.5 h-3.5" fill="@(isSaved ? "currentColor" : "none")" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </aside>
        </div>
        }
    }
    else
    {
        <!-- Editorial Left-Aligned Idle State -->
        <div class="pt-4 pb-8 space-y-10">
            <div class="space-y-3 max-w-2xl">
                <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white leading-[1.15]">
                    Inspect genre balance, artist variety, and track diversity.
                </h1>
                <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
                    Paste any public link from Spotify, Apple Music, or YouTube Music. TuneTrack measures genre balance, artist variety, and era spread, then recommends complementary tracks.
                </p>
            </div>

            <!-- Borderless 3-column summary row in neutral tone -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 pt-6 border-t border-white/10">
                <div class="space-y-1">
                    <p class="font-display text-sm font-semibold text-zinc-100">Link or paste tracklists</p>
                    <p class="text-xs text-zinc-400 leading-relaxed text-pretty">Works with Spotify, Apple Music, and YouTube Music links, or pasted tracklists.</p>
                </div>
                <div class="space-y-1">
                    <p class="font-display text-sm font-semibold text-zinc-100">Score diversity</p>
                    <p class="text-xs text-zinc-400 leading-relaxed text-pretty">Weighted breakdown across genre balance, artist variety, and era&#160;spread.</p>
                </div>
                <div class="space-y-1">
                    <p class="font-display text-sm font-semibold text-zinc-100">Discover additions</p>
                    <p class="text-xs text-zinc-400 leading-relaxed text-pretty">Tailored track suggestions with 30-second audio previews and&#160;bookmarks.</p>
                </div>
            </div>

            <!-- Sample Playlists as Editorial Cover Tiles -->
            <section class="space-y-4 pt-2" aria-labelledby="sample-playlists-heading">
                <div class="flex items-baseline justify-between border-b border-white/10 pb-3">
                    <h2 id="sample-playlists-heading" class="font-display text-sm font-semibold text-zinc-200">
                        Sample playlists
                    </h2>
                    <span class="text-xs text-zinc-400">Offline ready</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    @foreach (var sample in SampleService.GetSamplePlaylists())
                    {
                        var sampleScore = DiversityScorer.CalculateScore(sample.Tracks);
                        <button type="button"
                                @onclick="() => LoadSample(sample.Id)"
                                disabled="@isLoading"
                                class="group text-left rounded-xl bg-zinc-900/40 hover:bg-zinc-900/80 p-3 transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 outline-none">
                            <div class="relative aspect-[16/10] w-full rounded-lg overflow-hidden bg-zinc-800">
                                <img src="@sample.CoverUrl"
                                     alt="@sample.Title cover art"
                                     loading="lazy"
                                     class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                                <div class="absolute bottom-2.5 left-3 right-3 flex items-baseline justify-between gap-2">
                                    <span class="text-[11px] font-medium text-zinc-200 truncate">
                                        @sample.Platform · @Pluralize(sample.Tracks.Count, "track", "tracks")
                                    </span>
                                    <span class="inline-flex items-baseline gap-0.5 px-2 py-0.5 rounded bg-zinc-950/90 font-mono tabular-nums text-xs flex-shrink-0">
                                        <span class="font-bold @GetScoreColor(sampleScore.TotalScore)">@FormatWholeScore(sampleScore.TotalScore)</span>
                                        <span class="text-zinc-400 text-[11px]">/100</span>
                                    </span>
                                </div>
                            </div>

                            <div class="pt-3 px-0.5 space-y-1">
                                <p class="font-display text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors truncate">
                                    @sample.Title
                                </p>
                                <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">
                                    @sample.Description
                                </p>
                            </div>
                        </button>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? Id { get; set; }

    private string inputUrl = "";
    private string? errorMessage;
    private bool isLoading;
    private string clientId = "";
    private AnalysisDashboardData? dashboard;

    // Tracklist filtering & sorting
    private string trackSearchQuery = "";
    private string? selectedGenreFilter;

    // Audio preview & interaction
    private string? currentPlayingPreview;
    private string? copiedTrackTitle;
    private HashSet<string> savedTrackTitles = new(StringComparer.OrdinalIgnoreCase);

    // Partial result fallback paste
    private const string PastedTrackListPlaceholder =
        "Daft Punk - One More Time\nKendrick Lamar - Alright\nFleet Foxes - White Winter Hymnal";
    private bool showPasteFallback;
    private string pastedTrackList = "";

    // Loading progress indicator for longer enrichment runs
    private CancellationTokenSource? _analysisCts;
    private bool showMatchingProgress;
    private int matchingCompleted;
    private int matchingTotal;
    private DateTime loadingStartedUtc;

    private string DetectedPlatform
    {
        get
        {
            if (string.IsNullOrWhiteSpace(inputUrl)) return "";
            string lower = inputUrl.ToLowerInvariant();
            if (lower.Contains("spotify.com")) return "Spotify";
            if (lower.Contains("music.apple.com")) return "Apple Music";
            if (lower.Contains("youtube.com") || lower.Contains("youtu.be")) return "YouTube Music";
            return "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                clientId = await JS.InvokeAsync<string>("tuneTrack.getClientId");
                await LoadSavedTrackState();

                // If launched with an ID from History, reload it
                if (Id.HasValue && Id.Value > 0)
                {
                    await LoadPlaylistFromHistory(Id.Value);
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error during client init: {ex.Message}");
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && !string.IsNullOrWhiteSpace(inputUrl))
        {
            await AnalyzeEnteredUrl();
        }
    }

    private async Task AnalyzeEnteredUrl()
    {
        if (string.IsNullOrWhiteSpace(inputUrl)) return;

        var cts = BeginLoadingProgress();
        showPasteFallback = false;
        pastedTrackList = "";
        dashboard = null;

        try
        {
            var progress = CreateMatchProgress(cts.Token);
            dashboard = await PlaylistService.AnalyzeUrlAsync(inputUrl.Trim(), clientId, progress, cts.Token);
            if (dashboard.IsPartialResult || dashboard.Playlist.Tracks.Count == 0)
            {
                showPasteFallback = true;
            }
            await RefreshLocalDisplayDate();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            EndLoadingProgress(cts);
        }
    }

    private async Task LoadSample(string sampleId)
    {
        var cts = BeginLoadingProgress();
        showPasteFallback = false;
        pastedTrackList = "";
        dashboard = null;

        try
        {
            dashboard = await PlaylistService.AnalyzeSampleAsync(sampleId, clientId, cts.Token);
            await RefreshLocalDisplayDate();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            EndLoadingProgress(cts);
        }
    }

    private async Task AnalyzePastedList()
    {
        if (string.IsNullOrWhiteSpace(pastedTrackList) || dashboard == null) return;

        var cts = BeginLoadingProgress();

        try
        {
            var progress = CreateMatchProgress(cts.Token);
            dashboard = await PlaylistService.AnalyzeManualTrackListAsync(
                title: dashboard.Playlist.Title,
                platform: dashboard.Playlist.Platform,
                coverUrl: dashboard.Playlist.CoverUrl,
                rawTrackList: pastedTrackList,
                clientId: clientId,
                progress: progress,
                cancellationToken: cts.Token
            );
            showPasteFallback = false;
            pastedTrackList = "";
            await RefreshLocalDisplayDate();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            EndLoadingProgress(cts);
        }
    }

    private CancellationTokenSource BeginLoadingProgress()
    {
        _analysisCts?.Cancel();
        _analysisCts?.Dispose();
        var cts = new CancellationTokenSource();
        _analysisCts = cts;

        isLoading = true;
        errorMessage = null;
        selectedGenreFilter = null;
        trackSearchQuery = "";
        showMatchingProgress = false;
        matchingCompleted = 0;
        matchingTotal = 0;
        loadingStartedUtc = DateTime.UtcNow;

        _ = RevealProgressAfterDelayAsync(cts.Token);
        return cts;
    }

    private void EndLoadingProgress(CancellationTokenSource cts)
    {
        if (ReferenceEquals(_analysisCts, cts))
        {
            _analysisCts.Cancel();
            isLoading = false;
            showMatchingProgress = false;
        }
    }

    private async Task RevealProgressAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), token);
            if (!token.IsCancellationRequested && isLoading)
            {
                showMatchingProgress = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private IProgress<(int Completed, int Total)> CreateMatchProgress(CancellationToken token) =>
        new InlineProgress<(int Completed, int Total)>(p =>
        {
            if (token.IsCancellationRequested) return;
            _ = InvokeAsync(() =>
            {
                if (token.IsCancellationRequested) return;
                matchingCompleted = p.Completed;
                matchingTotal = p.Total;
                if ((DateTime.UtcNow - loadingStartedUtc).TotalSeconds >= 2)
                {
                    showMatchingProgress = true;
                }
                StateHasChanged();
            });
        });

    public void Dispose()
    {
        _analysisCts?.Cancel();
        _analysisCts?.Dispose();
        _analysisCts = null;
    }

    private sealed class InlineProgress<T>(Action<T> handler) : IProgress<T>
    {
        public void Report(T value) => handler(value);
    }

    private async Task LoadPlaylistFromHistory(int playlistId)
    {
        isLoading = true;
        showPasteFallback = false;
        pastedTrackList = "";
        selectedGenreFilter = null;
        trackSearchQuery = "";
        try
        {
            var playlist = await PlaylistService.GetPlaylistByIdAsync(playlistId, clientId);
            if (playlist != null)
            {
                var tracks = playlist.Tracks.ToList();
                var diversity = new DiversityScoreResult(
                    TotalScore: playlist.DiversityScore,
                    GenreVariety: playlist.GenreVariety,
                    ArtistUniqueness: playlist.ArtistUniqueness,
                    EraSpread: playlist.EraSpread,
                    Summary: "Loaded from historical analysis."
                );

                dashboard = new AnalysisDashboardData(
                    Playlist: playlist,
                    Diversity: diversity,
                    Recommendations: new List<TrackSuggestion>(),
                    IsPartialResult: false,
                    WarningMessage: null
                );
                await RefreshLocalDisplayDate();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private string? formattedDisplayDate;

    private async Task RefreshLocalDisplayDate()
    {
        formattedDisplayDate = null;
        if (dashboard?.Playlist == null) return;

        try
        {
            var iso = DateTime.SpecifyKind(dashboard.Playlist.AnalyzedAt, DateTimeKind.Utc).ToString("O");
            var localDates = await JS.InvokeAsync<string[]>("tuneTrack.formatLocalDates", (object)new[] { iso });
            if (localDates.Length > 0)
            {
                formattedDisplayDate = localDates[0];
            }
        }
        catch
        {
            formattedDisplayDate = null;
        }
    }

    private string FormatDisplayDate(DateTime utcDate) =>
        formattedDisplayDate ?? DateTime.SpecifyKind(utcDate, DateTimeKind.Utc).ToString("MMM d, yyyy · HH:mm 'UTC'");

    private async Task LoadSavedTrackState()
    {
        if (string.IsNullOrWhiteSpace(clientId)) return;
        var saved = await PlaylistService.GetSavedRecommendationsAsync(clientId);
        savedTrackTitles = saved.Select(s => s.Title).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private async Task TogglePreview(string? previewUrl)
    {
        if (string.IsNullOrEmpty(previewUrl)) return;

        if (currentPlayingPreview == previewUrl)
        {
            currentPlayingPreview = null;
            await JS.InvokeVoidAsync("tuneTrack.stopAudio");
        }
        else
        {
            currentPlayingPreview = previewUrl;
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tuneTrack.togglePreview", previewUrl, dotNetRef);
        }
    }

    [JSInvokable]
    public void OnAudioStopped()
    {
        currentPlayingPreview = null;
        StateHasChanged();
    }

    private async Task CopyTrack(TrackSuggestion rec)
    {
        string text = $"{rec.Title} — {rec.Artist}";
        bool success = await JS.InvokeAsync<bool>("tuneTrack.copyToClipboard", text);
        if (success)
        {
            copiedTrackTitle = rec.Title;
            StateHasChanged();
            await Task.Delay(1500);
            if (copiedTrackTitle == rec.Title)
            {
                copiedTrackTitle = null;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleBookmark(TrackSuggestion rec)
    {
        if (string.IsNullOrWhiteSpace(clientId)) return;

        if (savedTrackTitles.Contains(rec.Title))
        {
            // Remove
            var saved = await PlaylistService.GetSavedRecommendationsAsync(clientId);
            var item = saved.FirstOrDefault(s => s.Title.Equals(rec.Title, StringComparison.OrdinalIgnoreCase));
            if (item != null)
            {
                await PlaylistService.RemoveSavedRecommendationAsync(item.Id, clientId);
                savedTrackTitles.Remove(rec.Title);
            }
        }
        else
        {
            // Save
            await PlaylistService.SaveRecommendationAsync(clientId, rec, dashboard?.Playlist.Id);
            savedTrackTitles.Add(rec.Title);
        }
        StateHasChanged();
    }

    private List<AnalyzedTrack> GetFilteredTracks()
    {
        if (dashboard?.Playlist?.Tracks == null) return new List<AnalyzedTrack>();

        var query = dashboard.Playlist.Tracks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(trackSearchQuery))
        {
            string q = trackSearchQuery.Trim();
            query = query.Where(t =>
                t.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                t.Artist.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (t.Album != null && t.Album.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(selectedGenreFilter))
        {
            query = query.Where(t => t.Genre != null && t.Genre.Equals(selectedGenreFilter, StringComparison.OrdinalIgnoreCase));
        }

        return query.ToList();
    }

    private List<string> GetAllGenres()
    {
        if (dashboard?.Playlist?.Tracks == null) return new List<string>();

        return dashboard.Playlist.Tracks
            .Select(t => t.Genre?.Trim())
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .GroupBy(g => g!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .ToList();
    }

    private record GenreStat(string Genre, int Percentage);

    private List<GenreStat> GetGenreDistribution(int limit)
    {
        if (dashboard?.Playlist?.Tracks == null || dashboard.Playlist.Tracks.Count == 0) return new List<GenreStat>();

        var withGenre = dashboard.Playlist.Tracks
            .Select(t => t.Genre?.Trim())
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .ToList();

        if (withGenre.Count == 0) return new List<GenreStat>();

        int total = withGenre.Count;
        return withGenre
            .GroupBy(g => g!)
            .OrderByDescending(g => g.Count())
            .Take(limit)
            .Select(g => new GenreStat(g.Key, (int)Math.Round((double)g.Count() / total * 100)))
            .ToList();
    }

    private int GetDistinctGenreCount()
    {
        if (dashboard?.Playlist?.Tracks == null) return 0;
        return dashboard.Playlist.Tracks
            .Select(t => t.Genre?.Trim())
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    }

    private static string FormatWholeScore(double score) =>
        Math.Round(score, MidpointRounding.AwayFromZero).ToString("0");

    private static string Pluralize(int count, string singular, string plural) =>
        $"{count} {(count == 1 ? singular : plural)}";

    private static string GetPlatformBadgeClass(string platform)
    {
        return platform switch
        {
            "Spotify" => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
            "Apple Music" => "bg-rose-500/10 text-rose-400 border border-rose-500/20",
            "YouTube Music" => "bg-red-500/10 text-red-400 border border-red-500/20",
            "Sample" => "bg-zinc-800 text-zinc-200 border border-white/15",
            _ => "bg-zinc-800 text-zinc-300 border border-white/5"
        };
    }

    private static string GetScoreColor(double score)
    {
        return score switch
        {
            >= 80 => "text-emerald-400",
            >= 60 => "text-cyan-400",
            >= 40 => "text-amber-400",
            _ => "text-rose-400"
        };
    }

    private static string FormatTrackDuration(int durationMs)
    {
        if (durationMs <= 0) return "—";
        var ts = TimeSpan.FromMilliseconds(durationMs);
        return $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}";
    }
}
